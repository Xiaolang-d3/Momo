# Provider: demo | openai | ollama  (default: demo — no network)
MOMO_PROVIDER=demo

# OpenAI-compatible (only when MOMO_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama local (only when MOMO_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
